<?xml version="1.0" encoding="utf-8"?>
<automotiveApp>
    <!--
        Declares this app to Android Auto as an OEM-projection app. The
        "projection" capability is what lets the SDK render CarBrowserActivity
        (an arbitrary WebView surface) on the head unit, and "service" points
        Android Auto at the CarActivityService (com.kododake.aabrowser.car.CarService).

        This is the mechanism used by every working projected-WebView app
        (Screen2Auto, WebViewAuto, reactmap-android). Unlike the
        androidx.car.app NAVIGATION path, the projection channel is NOT subject
        to Android Auto's per-activity distraction lockout, so the browser stays
        usable while the car is moving.
    -->
    <uses name="projection" />
    <uses name="service" />
    <uses name="notification" />
</automotiveApp>
